# Configuration for the depot IoT hub. Install to /etc/iot-hub.env, mode 0600
# (it holds the operator and provisioning keys).

# --- network ---------------------------------------------------------------
HUB_HOST=0.0.0.0
HUB_PORT=8080

# TLS from the depot's own offline CA. Both must be set to enable HTTPS.
#
# Vehicle traffic is HMAC-signed in BOTH directions, so that channel is not
# forgeable over plain HTTP. The OPERATOR channel is different: the key below
# is a bearer token sent verbatim on every request, and it can mint vehicle
# secrets via rotate-secret. The hub therefore refuses to start with an
# operator or provisioning key set unless TLS is on -- or unless you opt out
# explicitly below. See docs/OFFLINE_DEPLOYMENT.md.
#HUB_TLS_CERT=/etc/iot-hub/tls/hub.crt
#HUB_TLS_KEY=/etc/iot-hub/tls/hub.key
#HUB_REQUIRE_TLS=false

# --- storage ---------------------------------------------------------------
HUB_DATA_DIR=/var/lib/iot-hub
# 72h of history for 450 vehicles is roughly 12 GB at 1 Hz. Size to the disk.
HUB_TELEMETRY_RETENTION_HOURS=72
HUB_PURGE_INTERVAL_SECONDS=900

# --- security --------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HUB_OPERATOR_KEY=CHANGE_ME_operator_key
# Accept a cleartext operator key (testing, or a trusted loopback only).
# Leave false in any real depot deployment and configure TLS instead.
HUB_ALLOW_INSECURE_OPERATOR_API=false
# Leave empty to disable over-the-wire enrollment (offline provisioning only).
HUB_PROVISIONING_KEY=
HUB_CLOCK_SKEW_SECONDS=300

# --- ingest ----------------------------------------------------------------
HUB_MAX_BODY_BYTES=1048576
HUB_MAX_BATCH_POINTS=500

# --- command dispatch ------------------------------------------------------
# Keep below the idle timeout of any switch or proxy between hub and vehicles.
HUB_MAX_LONG_POLL_SECONDS=25
HUB_COMMAND_LEASE_SECONDS=60
HUB_COMMAND_MAX_ATTEMPTS=5

# --- fleet -----------------------------------------------------------------
HUB_FLEET_SIZE=450
HUB_VEHICLE_OFFLINE_AFTER=90

HUB_LOG_LEVEL=INFO

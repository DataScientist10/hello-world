# Configuration for the depot IoT hub. Install to /etc/iot-hub.env, mode 0600
# (it holds the operator and provisioning keys).

# --- network ---------------------------------------------------------------
HUB_HOST=0.0.0.0
HUB_PORT=8080

# TLS from the depot's own offline CA. Both must be set to enable HTTPS.
#
# Vehicle traffic is HMAC-signed in BOTH directions, so that channel is not
# forgeable over plain HTTP. The OPERATOR channel is different: the key below
# is a bearer token sent verbatim on every request, and it can mint vehicle
# secrets via rotate-secret. The hub therefore refuses to start with an
# operator or provisioning key set unless TLS is on -- or unless you opt out
# explicitly below. See docs/OFFLINE_DEPLOYMENT.md.
#HUB_TLS_CERT=/etc/iot-hub/tls/hub.crt
#HUB_TLS_KEY=/etc/iot-hub/tls/hub.key
#HUB_REQUIRE_TLS=false

# --- storage ---------------------------------------------------------------
HUB_DATA_DIR=/var/lib/iot-hub
# 72h of history for 450 vehicles is roughly 12 GB at 1 Hz. Size to the disk.
HUB_TELEMETRY_RETENTION_HOURS=72
HUB_PURGE_INTERVAL_SECONDS=900

# Disk-pressure backstop. Retention assumes the sample rate, fleet size and
# disk stay as configured; these thresholds cover the case where that bet is
# wrong. Below the warn line the hub purges harder than retention alone; below
# the critical line it also stops accepting telemetry, so the remaining space
# is kept for command dispatch. Vehicles buffer locally and catch up.
# Thresholds are a ratio capped by absolute headroom, so they behave on both a
# 20 GB depot SSD and a multi-terabyte array: warn below min(20%, 20 GiB),
# shed below max(512 MiB, min(7%, 5 GiB)). At the measured 5.8 GB/day that is
# roughly 3.5 days of headroom to the warning and under a day to shedding.
HUB_DISK_WARN_FREE_RATIO=0.20
HUB_DISK_WARN_FREE_CAP_BYTES=21474836480
HUB_DISK_CRITICAL_FREE_RATIO=0.07
HUB_DISK_CRITICAL_FREE_CAP_BYTES=5368709120
HUB_DISK_MIN_FREE_BYTES=536870912
HUB_DISK_CHECK_INTERVAL_SECONDS=60
# Telemetry inside this window is never purged, however hard the disk squeezes.
HUB_DISK_MIN_RETENTION_HOURS=1
HUB_DISK_PURGE_BATCH_ROWS=50000

# --- security --------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HUB_OPERATOR_KEY=CHANGE_ME_operator_key
# Read-only scope, presented on the same X-Operator-Key header. Give this one
# to anything that only needs to *see* the fleet -- a wall dashboard, a
# monitoring box, a supervisor's browser. Those should not hold a credential
# that can broadcast a pull_over or mint a vehicle's signing secret. Must be a
# different value from HUB_OPERATOR_KEY; the hub refuses to start otherwise.
HUB_VIEWER_KEY=

# Serve the operator console at http://<hub>:8080/console. The page carries no
# credential -- an operator supplies a viewer key, which stays in that browser
# tab. Set false on a hub driven purely from the CLI.
HUB_CONSOLE_ENABLED=true
# Accept a cleartext operator key (testing, or a trusted loopback only).
# Leave false in any real depot deployment and configure TLS instead.
HUB_ALLOW_INSECURE_OPERATOR_API=false
# Leave empty to disable over-the-wire enrollment (offline provisioning only).
HUB_PROVISIONING_KEY=
HUB_CLOCK_SKEW_SECONDS=300

# --- ingest ----------------------------------------------------------------
HUB_MAX_BODY_BYTES=1048576
HUB_MAX_BATCH_POINTS=500

# --- command dispatch ------------------------------------------------------
# Keep below the idle timeout of any switch or proxy between hub and vehicles.
HUB_MAX_LONG_POLL_SECONDS=25
HUB_COMMAND_LEASE_SECONDS=60
HUB_COMMAND_MAX_ATTEMPTS=5

# --- fleet -----------------------------------------------------------------
HUB_FLEET_SIZE=450
HUB_VEHICLE_OFFLINE_AFTER=90

HUB_LOG_LEVEL=INFO
